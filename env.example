# Copy this file to ".env" and edit it.
#
# Read at BUILD time, so re-run `npm run build` after changing it
# (scripts\self-update.bat rebuilds for you).

# ── Where the backend API is ────────────────────────────────────────────────
#
# On the workstation, name only the PORT. The machine has no static IP, so the
# browser builds the address from whatever host it opened the app on:
# open http://192.168.1.50:5173 and the API is called on
# http://192.168.1.50:4000 — no rebuild when the address changes.
API_PORT=4000

# A backend on a DIFFERENT machine needs its full address instead (this wins
# over API_PORT):
# API_URL=http://192.168.1.50:4000
#
# ⚠️ API_URL=http://localhost:4000 is a trap: every other computer in the
# department would then call ITS OWN localhost. Leave it unset, or use
# API_PORT above.

# Full endpoint override, only if GraphQL is not served at the host root:
# VITE_GRAPHQL_URL=http://localhost:4000/
